# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real secrets.

# Use this DATABASE_URL when running the backend directly on your host
# machine (e.g. `uvicorn app.main:app --reload`) against a local Postgres.
# When running via `docker compose up`, docker-compose.yml overrides this
# automatically to point at the "postgres" service instead of localhost.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/leetcode_db

JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_TOKEN_EXPIRE_HOURS=24

# URL of the code-execution (Docker runner) microservice built by the
# Docker teammate. Locally it usually runs on its own port on your machine.
RUNNER_URL=http://127.0.0.1:9000

# Comma-separated list of frontend origins allowed to call this API.
# Use "*" for local development only - never in production.
ALLOWED_ORIGINS=*

# Rate limits, format "calls/seconds"
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_REGISTER=5/60
RATE_LIMIT_SUBMIT=10/60
RATE_LIMIT_RUN=20/60

# Leave SMTP_HOST empty to just print verification/reset emails to the
# console (default - no mail server needed for local dev/demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@leetcode-clone.local
